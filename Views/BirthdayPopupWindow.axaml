<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ci="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
        mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="150"
        x:Class="ClassIsland.BirthdayReminder.Views.BirthdayPopupWindow"
        Title="生日提醒"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Window.Styles>
        <Style Selector="Border.celebrate">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- 生日当天的发光光晕，仅当 Classes 包含 celebrate 时可见 -->
        <Border Name="GlowBorder"
                Classes="celebrate"
                Background="#FFC94D"
                CornerRadius="18"
                Opacity="0"
                Margin="-6" />

        <Border Name="RootCard"
                Background="#F2222831"
                CornerRadius="16"
                Padding="16"
                BoxShadow="0 8 24 0 #40000000"
                Opacity="0"
                RenderTransform="scale(0.85)"
                RenderTransformOrigin="0.5,0.5"
                PointerPressed="RootCard_OnPointerPressed">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.32" Easing="CubicEaseOut" />
                </Transitions>
            </Border.Transitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="48" Height="48" CornerRadius="24" Background="#FFB13D" VerticalAlignment="Top">
                    <TextBlock Name="EmojiText" Text="🎂" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="4" MaxWidth="250">
                    <TextBlock Name="TitleText" Text="生日提醒" FontSize="15" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Name="ContentText" Text="" FontSize="13" Foreground="#E6FFFFFF" TextWrapping="Wrap" />
                    <TextBlock Name="HintText" Text="点击关闭" FontSize="10" Foreground="#99FFFFFF" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
